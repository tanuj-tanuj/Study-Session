{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "college": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "joinedAt"]
    },
    "Room": {
      "title": "Room",
      "description": "Virtual study room session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "meetLink": { "type": "string" },
        "participantCount": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "enableChat": { "type": "boolean" }
      },
      "required": ["title", "subject", "creatorId", "createdAt", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message in a study room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "senderId", "content", "timestamp"]
    },
    "Participation": {
      "title": "Participation",
      "description": "Record of a user joining a study room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "roomTitle": { "type": "string" },
        "roomSubject": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "roomTitle", "roomSubject", "joinedAt"]
    },
    "Note": {
      "title": "Note",
      "description": "Collaborative study note",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "authorId", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Private message thread between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "participantNames": { "type": "object" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "updatedAt"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Private message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "content", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "users/{userId}/participation/{participationId}": {
      "schema": "Participation",
      "description": "User's study session history"
    },
    "users/{userId}/reminders/{reminderId}": {
      "schema": "object",
      "description": "Scheduled session reminders"
    },
    "rooms/{roomId}": {
      "schema": "Room",
      "description": "Study rooms"
    },
    "rooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages within a room"
    },
    "rooms/{roomId}/resources/{resourceId}": {
      "schema": "object",
      "description": "Shared study materials and links"
    },
    "rooms/{roomId}/notes/{noteId}": {
      "schema": "Note",
      "description": "Shared room notes"
    },
    "conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Direct message threads"
    },
    "conversations/{conversationId}/messages/{messageId}": {
      "schema": "DirectMessage",
      "description": "Individual direct messages"
    }
  }
}
