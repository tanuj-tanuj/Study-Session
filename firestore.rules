rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection ---
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.joinedAt is string;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Users shouldn't be listable for privacy
      allow create: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && (incoming().keys().hasAll(['uid', 'displayName', 'email', 'joinedAt']) && incoming().keys().size() <= 6);
      allow update: if isSignedIn() && isOwner(userId) && isValidUser(incoming()) && (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'college', 'photoURL']));

      // --- Participation History ---
      match /participation/{participationId} {
        function isValidParticipation(data) {
          return data.roomId is string &&
                 data.roomTitle is string &&
                 data.roomSubject is string &&
                 data.joinedAt is string;
        }

        allow list: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId) && isValidParticipation(incoming());
      }

      // --- Reminders ---
      match /reminders/{reminderId} {
        function isValidReminder(data) {
          return data.roomId is string &&
                 data.roomTitle is string &&
                 data.time is string &&
                 data.createdAt is string;
        }

        allow read, write: if isSignedIn() && isOwner(userId) && (request.method != 'create' || isValidReminder(incoming()));
      }
    }

    // --- Rooms Collection ---
    function isValidRoom(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.subject is string && data.subject.size() <= 100 &&
             data.creatorId == request.auth.uid &&
             data.status in ['active', 'closed'] &&
             data.createdAt is string &&
             (!('durationMinutes' in data) || (data.durationMinutes is number && data.durationMinutes >= 0)) &&
             (!('enableChat' in data) || data.enableChat is bool);
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn(); // Any student can see study rooms
      allow create: if isSignedIn() && isEmailVerified() && isValidRoom(incoming()) && 
                    incoming().keys().hasAll(['title', 'subject', 'creatorId', 'createdAt', 'status']) &&
                    incoming().keys().size() <= 15;
      
      allow update: if isSignedIn() && (
        // Action: Join (increment participantCount)
        (incoming().diff(existing()).affectedKeys().hasOnly(['participantCount']) && incoming().participantCount == existing().participantCount + 1) ||
        // Action: Leave (decrement participantCount)
        (incoming().diff(existing()).affectedKeys().hasOnly(['participantCount']) && incoming().participantCount == existing().participantCount - 1) ||
        // Action: Close/Edit/Extend (Owner only)
        (isOwner(existing().creatorId) && isValidRoom(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'subject', 'status', 'meetLink', 'durationMinutes', 'enableChat'])) ||
        // Action: Creator Extend Time
        (isOwner(existing().creatorId) && incoming().diff(existing()).affectedKeys().hasOnly(['durationMinutes']) && incoming().durationMinutes is number)
      );
      
      allow delete: if false; // Rooms should be closed, not deleted, for history/metrics

      // --- Messages Subcollection ---
      match /messages/{messageId} {
        function isValidMessage(data) {
          return data.roomId == roomId &&
                 data.senderId == request.auth.uid &&
                 data.content is string && data.content.size() <= 1000 &&
                 data.timestamp is string;
        }

        // Only allow reading and writing if the parent room exists and is active
        allow read, list: if isSignedIn();
        allow create: if isSignedIn() && isEmailVerified() && isValidMessage(incoming()) &&
                      get(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'active';
      }

      match /presence/{userId} {
        allow read, list: if isSignedIn();
        allow create, update: if isSignedIn() && isOwner(userId) && 
                     incoming().status in ['active', 'away'] &&
                     incoming().lastActive is string &&
                     incoming().isTyping is bool;
        allow delete: if isSignedIn() && isOwner(userId);
      }

      match /resources/{resourceId} {
        function isValidResource(data) {
          return data.title is string && data.title.size() <= 100 &&
                 data.url is string && data.url.size() <= 500 &&
                 data.addedBy == request.auth.uid;
        }

        allow read: if isSignedIn();
        allow create: if isSignedIn() && isEmailVerified() && isValidResource(incoming());
        allow delete: if isSignedIn() && (resource.data.addedBy == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.creatorId == request.auth.uid);
      }

      match /notes/{noteId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isEmailVerified();
        allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.creatorId == request.auth.uid);
      }
    }

    // --- Direct Messaging ---
    match /conversations/{conversationId} {
      function isConversationParticipant(data) {
        return request.auth.uid in data.participants;
      }

      allow list: if isSignedIn() && isConversationParticipant(resource.data);
      allow get: if isSignedIn() && isConversationParticipant(resource.data);
      allow create: if isSignedIn() && isEmailVerified() && 
                    isConversationParticipant(incoming()) && 
                    incoming().participants.size() == 2;
      allow update: if isSignedIn() && isConversationParticipant(existing()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);

      match /messages/{messageId} {
        allow read, list: if isSignedIn() && 
                          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn() && isEmailVerified() &&
                      request.auth.uid == incoming().senderId &&
                      request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}
